	Slider "Launcher Pump: Rounds Per Grenade", "ae_glpump_cost", 1, 40, 1, 0
	Slider "Launcher Pump: Grab Radius (cm)", "ae_glpump_grab", 6.0, 30.0, 1.0, 0
	Option "Body Holsters", "ae_holsters", "OnOff"
	Option "Ballistics", "rsq_ballistics", "AE_Ballistics"
	Option "Spent Casings", "ae_casings", "OnOff"
	Option "Rounds Leave the Barrel", "ae_muzzle_bore", "OnOff"
	StaticText " "
	Submenu "Smartgun Options", "AE_SmartOptions"
